{
  "name": "dispensary-tracker",
  "version": "1.0.0",
  "description": "Dispensary Receipt Tracker — Electron desktop app",
  "author": "Natani",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.natani.dispensary-tracker",
    "productName": "Dispensary Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/**",
      "!*.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "icon": "assets/icon.png",
      "identity": null,
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Finance"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "onnxruntime-node": "^1.27.0",
    "sharp": "^0.35.2"
  }
}
